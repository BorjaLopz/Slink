{
	"name": "slink",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"gen:levels": "tsx scripts/gen-levels.ts",
		"validate:levels": "tsx scripts/validate-levels.ts"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
